import os
q_scores = str(config['qscores']).split(',')
lengths = str(config['lengths']).split(',')
aug_config = os.path.join(str(config['wrapper_dir']), 'resources/augustus_config')
busco_downloads = os.path.join(str(config['wrapper_dir']), 'resources/busco_downloads')
samples = [file.split('.')[0] for file in os.listdir('data') if file.endswith('fastq.gz')]

if workflow.cores > 48:
    braker_threads = 48
else:
    braker_threads = workflow.cores

if workflow.cores > 20:
    nextdenovo_threads = 20
else:
    nextdenovo_threads = workflow.cores

rule all:
    input:
        expand('results/final/{sample}/eukaryotes.fasta', sample=samples),
        
rule clean_fastq:
    input:
        'data/{sample}.fastq.gz'
    output:
        'results/clean_fastq/{sample}.fastq.gz'
    log:
        'results/logs/clean_fastq/{sample}.log'
    params:
        contam='resources/contaminants.fasta'
    threads:
        workflow.cores
    conda:
        'envs/clean_fastq.yaml'
    shell:
        'minimap2 -t {threads} -ax map-ont {params.contam} {input} 2> {log} | samtools fastq -n -f 4 - 2>> {log} | gzip > {output} 2>> {log}'

rule chopper:
    input:
        'results/clean_fastq/{sample}.fastq.gz'
    output:
        'results/chopper/{sample}.fastq.gz'
    log:
        'results/logs/chopper/{sample}.log'
    params:
        length = 1000,
        quality = 10
    threads:
        workflow.cores
    conda:
        'envs/chopper.yaml'
    shell:
        'gunzip -c {input} 2> {log} | chopper -l {params.length} -q {params.quality} --threads {threads} 2>> {log} | gzip > {output} 2>> {log}'

rule metaflye:
    input:
        'results/chopper/{sample}.fastq.gz'
    output:
        'results/metaflye/{sample}/assembly.fasta',
        'results/metaflye/{sample}/assembly_graph.gfa',
        'results/metaflye/{sample}/assembly_graph.gv',
        'results/metaflye/{sample}/assembly_info.txt',
    log:
        'results/logs/metaflye/{sample}.log'
    params:
        out_dir='results/metaflye/{sample}'
    threads:
        workflow.cores
    conda:
        'envs/flye.yaml'
    shell:
        '''
        flye \
            --meta \
            --no-alt-contigs \
            --nano-raw {input} \
            --out-dir {params.out_dir} \
            --threads {threads} &> {log}
        '''

rule whokaryote:
    input:
        'results/metaflye/{sample}/assembly.fasta'
    output:
        'results/whokaryote/{sample}/eukaryotes.fasta',
        'results/whokaryote/{sample}/prokaryotes.fasta',
        'results/whokaryote/{sample}/whokaryote_predictions_T.tsv',
    log:
        'results/logs/whokaryote/{sample}.log'
    threads:
        workflow.cores
    params:
        out_dir='results/whokaryote/{sample}',
    conda:
        'envs/whokaryote.yaml'
    shell:
        '''
        whokaryote.py --contigs {input} --outdir {params.out_dir} --threads {threads} --f &> {log}
        '''

rule bakta:
    input:
        'results/whokaryote/{sample}/prokaryotes.fasta'
    output:
        'results/bakta/{sample}/prokaryotes.gff3'
    log:
        'results/logs/bakta/{sample}.log'
    params:
        out_dir='results/bakta/{sample}',
        db=os.path.join(str(config['wrapper_dir']), 'resources/db-light'),
    conda:
        'envs/bakta.yaml'
    shell:
        'bakta --keep-contig-headers --db {params.db} --force --output {params.out_dir} {input} &> {log}'

rule gc_content:
    input:
        'results/whokaryote/{sample}/whokaryote_predictions_T.tsv',
        'results/metaflye/{sample}/assembly.fasta'
    output:
    log:
        'results/logs/gc_content/{sample}.log'
    script:
        'scripts/post_who_gc_content.py'

rule cleaner_fastq:
    input:
        'results/whokaryote/{sample}/prokaryotes.fasta',
        'results/clean_fastq/{sample}.fastq.gz'
    output:
        'results/cleaner_fastq/{sample}.fastq.gz'
    log:
        'results/logs/cleaner_fastq/{sample}.log'
    threads:
        workflow.cores
    conda:
        'envs/clean_fastq.yaml'
    shell:
        '''
        minimap2 -t {threads} -ax map-ont {input[0]} {input[1]} 2> {log} | \
        samtools fastq -n -f 4 - | gzip > {output} 2>> {log}
        '''

rule nextdenvovo:
    input:
        'results/cleaner_fastq/{sample}.fastq.gz',
        'results/whokaryote/{sample}/eukaryotes.fasta',
    output:
        'results/nextdenovo/{sample}/03.ctg_graph/nd.asm.fasta',
    log:
        'results/logs/nextdenovo/{sample}.log'
    params:
        out_dir='results/nextdenovo/{sample}',
    threads:
        nextdenovo_threads
    conda:
        'envs/nextdenovo.yaml'
    shell:
        '''
        ls {input[0]} > input.fofn
        echo "[General]" > run.cfg
        echo "job_type = local" >> run.cfg
        echo "job_prefix = nextDenovo" >> run.cfg
        echo "task = all" >> run.cfg
        echo "rewrite = yes" >> run.cfg
        echo "deltmp = yes" >> run.cfg
        echo "parallel_jobs = {threads}" >> run.cfg
        echo "input_type = raw" >> run.cfg
        echo "read_type = ont" >> run.cfg
        echo "input_fofn = input.fofn" >> run.cfg
        echo "workdir = {params.out_dir}" >> run.cfg
        echo "" >> run.cfg
        echo "[correct_option]" >> run.cfg
        echo "read_cutoff = 1k" >> run.cfg
        echo -n "genome_size = " >> run.cfg
        grep -o -E '[ATCG]' {input[1]} | wc -l >> run.cfg
        echo "sort_options = -m 20g -t 15" >> run.cfg
        echo "minimap2_options_raw = -t 8" >> run.cfg
        echo "pa_correction = 3" >> run.cfg
        echo "correction_options = -p 15" >> run.cfg
        echo "" >> run.cfg
        echo "[assemble_option]" >> run.cfg
        echo "minimap2_options_cns = -t 8" >> run.cfg
        echo "nextgraph_options = -a 1" >> run.cfg
        nextDenovo run.cfg &> {log}
        '''
        

rule nextdenovo_whokaryote:
    input:
        'results/nextdenovo/{sample}/03.ctg_graph/nd.asm.fasta'
    output:
