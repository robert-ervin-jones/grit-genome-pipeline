rule braker:
    input:
        'results/repeatmasker/{sample}/eukaryotes.fasta.masked',
    output:
        'results/braker/{sample}/braker.aa',
        'results/braker/{sample}/braker.gtf'
    log:
        'results/logs/braker/{sample}.log'
    params:
        out_dir='results/braker/{sample}',
        config_dir=aug_config,
    threads:
        braker_threads
    container:
        'docker://teambraker/braker3:v3.0.7.6'
    shell:
